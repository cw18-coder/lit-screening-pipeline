{
  "name": "lit-screening-pipeline-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Interactive PRISMA and .github/ wiki front-end for the lit-screening-pipeline release.",
  "engines": {
    "node": ">=20 <21"
  },
  "packageManager": "pnpm@9.7.0",
  "scripts": {
    "build:data": "node scripts/build-data.mjs",
    "build:wiki": "node scripts/build-wiki.mjs",
    "predev": "node scripts/build-data.mjs && node scripts/build-wiki.mjs",
    "dev": "vite",
    "prebuild": "node scripts/gate-prebuild.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts --ext .ts,.tsx,.mjs",
    "format": "prettier --check src scripts"
  },
  "dependencies": {
    "@xyflow/react": "12.3.5",
    "flexsearch": "0.7.43",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "9.0.1",
    "react-router-dom": "6.26.2",
    "rehype-highlight": "7.0.0",
    "rehype-slug": "6.0.0",
    "remark-gfm": "4.0.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/react": "18.3.5",
    "@types/react-dom": "18.3.0",
    "@vitejs/plugin-react": "4.3.1",
    "csv-parse": "5.5.6",
    "dotenv": "16.4.5",
    "eslint": "9.10.0",
    "gray-matter": "4.0.3",
    "prettier": "3.3.3",
    "typescript": "5.5.4",
    "vite": "5.4.6"
  }
}
